<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light window theme; values-night/themes.xml overrides it for system dark mode.
         windowBackground matches core-ui Paper so there is no flash before Compose draws. -->
    <style name="Theme.Doorman" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/doorman_window_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
